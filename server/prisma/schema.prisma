datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  name          String?
  isVerified    Boolean  @default(false)
  accessStatus  String   @default("NOT_PAID") // NOT_PAID | PENDING | ACTIVE

  payments      Payment[]
  sessions      Session[]
  bookingCodes  UserBookingCode[]
  purchases     Purchase[]

  createdAt     DateTime @default(now())
}

model Payment {
  id             String   @id @default(uuid())
  userId         String
  amount         Float
  transactionId  String   @unique
  screenshotUrl  String
  referenceCode  String
  status         String   @default("PENDING") // PENDING | APPROVED | REJECTED

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model BookingCode {
  id         String   @id @default(uuid())
  code       String   @unique
  matchName  String
  expiryDate DateTime
  price      Float?   @default(0)

  users UserBookingCode[]
  purchases Purchase[]
  createdAt DateTime @default(now())
}

model Purchase {
  id            String   @id @default(uuid())
  userId        String
  bookingCodeId String
  amount        Float
  status        String   @default("PENDING") // PENDING | APPROVED | REJECTED

  user User @relation(fields: [userId], references: [id])
  bookingCode BookingCode @relation(fields: [bookingCodeId], references: [id])

  createdAt DateTime @default(now())
}

model UserBookingCode {
  id            String @id @default(uuid())
  userId        String
  bookingCodeId String

  user        User        @relation(fields: [userId], references: [id])
  bookingCode BookingCode @relation(fields: [bookingCodeId], references: [id])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  deviceId  String
  ipAddress String

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}