# Copy this file to `server/.env` and fill in real values (do NOT commit secrets).
# Example placeholders — replace before running in development or production.
DATABASE_URL=postgresql://postgres:REDACTED_DB_PASSWORD@localhost:5432/bestoddsgh
JWT_SECRET=replace_me_with_a_strong_random_string
EMAIL_USER=your-email@example.com
EMAIL_PASS=replace_with_email_password
CLIENT_URL=http://localhost:3000
PORT=5000

# App URL used to build verification links
APP_URL=http://localhost:5000
APP_DOMAIN=localhost
APP_NAME=Mail

# Optional SMTP settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Admin credentials for admin API (used by admin UI)
ADMIN_USER=admin_user
ADMIN_PASS=admin_password

# Cloudinary credentials (used for persistent uploads in production)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
